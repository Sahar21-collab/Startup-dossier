# Copy this file to .env.local and fill in your own keys.
# Never share these values or put them on GitHub.

# Tavily (web search): https://app.tavily.com
TAVILY_API_KEY=

# Google Gemini (AI summary): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to try first
# GEMINI_MODEL=gemini-3.6-flash

# Supabase (saved searches): Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=
